# ===== 复制本文件为 .env，填入真实配置 =====

# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/aigc_platform

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=product-images
MINIO_SECURE=false

# AIGC 生成 API（二选一）
# 方式A：Stability AI（需要注册获取 API Key）
AIGC_PROVIDER=mock
STABILITY_API_KEY=your_key_here

# 方式B：本地 ComfyUI（如果有 GPU）
COMFYUI_URL=http://localhost:8188

# 区块链（目前使用 mock，后续接入 FISCO BCOS）
BLOCKCHAIN_PROVIDER=mock
FISCO_RPC_URL=http://localhost:8545
